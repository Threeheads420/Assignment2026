<!-- Insert the navigation menu from the menu.hbs partial.
     This is the site menu that appears at the top of every page. -->
{{> menu}}
<!-- Main page title -->
<div class="ui raised segment" style="margin-top: 1.5rem;">
  <div class="ui stackable two column grid">

    <!-- LEFT: Title -->
    <div class="eight wide column">
      <h1 class="ui header">
        <i class="globe icon"></i>
        <div class="content">
          {{title}}
          <div class="sub header">The Solar System Planet Overview</div>
        </div>
      </h1>
    </div>

    <!-- RIGHT: Small planet images -->
    <div class="eight wide column" style="display: flex; align-items: center; justify-content: center;">
      <div style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;">

        <a href="#Mercury"><img src="/images/planets/Mercury.gif" style="width:45px; height:45px; border-radius:50%;"></a>
        <a href="#Venus"><img src="/images/planets/Venus.gif" style="width:45px; height:45px; border-radius:50%;"></a>
        <a href="#Earth"><img src="/images/planets/Earth.gif" style="width:45px; height:45px; border-radius:50%;"></a>
        <a href="#Mars"><img src="/images/planets/Mars.gif" style="width:45px; height:45px; border-radius:50%;"></a>
        <a href="#Jupiter"><img src="/images/planets/Jupiter.gif" style="width:45px; height:45px; border-radius:50%;"></a>
        <a href="#Saturn"><img src="/images/planets/Saturn.gif" style="width:45px; height:45px; border-radius:50%;"></a>
        <a href="#Uranus"><img src="/images/planets/Uranus.gif" style="width:45px; height:45px; border-radius:50%;"></a>
        <a href="#Neptune"><img src="/images/planets/Neptune.gif" style="width:45px; height:45px; border-radius:50%;"></a>

      </div>
    </div>

  </div>
</div>
<!-- Container holding the planet cards -->
<div class="ui three stackable centered cards">
   <!-- Loop through the planets array -->
  {{#each planets}}
    <!-- Individual planet card -->
    <div class="ui raised card" id="{{name}}">
      <!-- Planet image -->
      <div class="image">
        <img src="{{image}}">
      </div>
        <!-- Main content of the card -->
      <div class="content">
        <!-- Planet name -->
        <div class="header">{{name}}</div>
        <!-- Planet type label (gas giant, terrestrial, etc.) -->
        <div class="meta">
          <span class="ui small blue label">{{type}}</span>
        </div>
         <!-- Distance information -->
        <div class="description" style="margin-top:10px;">
          <strong>Distance from Sun:</strong><br>
          {{distance}} ({{au}})
        </div>
      </div>
       <!-- Bottom section of the card -->
      <div class="extra content">
       <!-- Moon count -->
        <i class="moon icon"></i>
          {{moons}} Moon(s)
          <!-- Button linking to the detailed planet page -->
      <div style="display: flex; align-items: center; justify-content: flex-end; gap: 6px;">
  <span style="font-size: 0.8em;">More info</span>
  <i class="arrow right icon" style="font-size: 0.8em;"></i>
  <a class="ui icon button" href="/planet/{{id}}">
    <i class="info circle icon"></i>
  </a>
</div>
       
      </div>

    </div>
  {{/each}}

</div>
<!-- Image credit footer -->
<div class="ui raised segment" style="margin-top: 1.5rem; text-align: center;">
  Images courtesy of 
  <a href="https://www.nasa.gov/" target="_blank">NASA</a>
</div>