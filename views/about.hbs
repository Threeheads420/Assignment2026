{{>menu}}

<div class="ui raised segment">
  <h1 class="ui center aligned header">
    <i class="info circle icon"></i>
    <div class="content">
      {{title}}
      <div class="sub header">{{site.title}}</div>
    </div>
  </h1>

  {{#each site.intro}}
    <p class="ui center aligned">{{this}}</p>
  {{/each}}
<div class="ui raised segment">
  <h2 class="ui header">App Statistics</h2>

  <div class="ui four statistics">
    <div class="statistic">
      <div class="value">{{stats.totalPlanets}}</div>
      <div class="label">Planets</div>
    </div>

    <div class="statistic">
      <div class="value">{{stats.totalMoons}}</div>
      <div class="label">Moons</div>
    </div>

    <div class="statistic">
      <div class="value">{{stats.terrestrialPlanets}}</div>
      <div class="label">Terrestrial</div>
    </div>

    <div class="statistic">
      <div class="value">{{stats.giantPlanets}}</div>
      <div class="label">Giants</div>
    </div>
  </div>
</div>
  

  <h2 class="ui header">{{vastness.heading}}</h2>

  <div class="ui stackable grid">
    
    <!-- LEFT SIDE (text) -->
    <div class="ten wide column">
      {{#each vastness.paragraphs}}
        <p>{{this}}</p>
      {{/each}}
    </div>

    <!-- RIGHT SIDE  -->
    <div class="six wide column">
      <div class="ui raised segment">
        <h3 class="ui header">
          <i class="globe icon"></i>
          Scale at a Glance
        </h3>

        <div class="ui relaxed divided list">
          {{#each vastness.scaleLine}}
            <div class="item">
              <i class="angle right icon"></i>
              <div class="content">
                <div class="header">{{this}}</div>
              </div>
            </div>
          {{/each}}
        </div>

      </div>
    </div>

  </div>
</div>

  {{#each scaleStory}}
    <div class="ui raised segment">
      <h3 class="ui header">{{title}}</h3>
      <img class="ui fluid rounded image" src="{{image}}">
      <p style="margin-top: 1rem;">{{{caption}}}</p>
    </div>
  {{/each}}

</div>

<div style="margin-top:20px; font-size:0.9em; text-align:center;">
  Astronomy images courtesy of
  <a href="https://www.nasa.gov/" target="_blank">NASA</a>
</div>