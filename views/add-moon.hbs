{{> menu}}

{{!--Page title--}}
<h1 class="ui center aligned header" style="color: white; text-shadow: 2px 2px 6px black;">
  {{title}}
</h1>

{{!--Error message--}}
{{#if error}}
  <div class="ui negative message">
    <p>Moon already saved. Return to Moons to choose again.</p>
  </div>
{{/if}}

{{!--Main container--}}
<div class="ui container">

  {{!--Form--}}
  <form class="ui form" action="/moons/add" method="POST" enctype="multipart/form-data" style="color: white;">

    {{!--ROW 1--}}
    <div class="two fields">
      <div class="field">
        <label>What's the Moon's Name?</label>
        <input type="text" name="name" required>
      </div>
      <div class="field">
        <label>Which Planet does it Orbit?</label>
        <input type="text" name="planet" required>
      </div>
    </div>

    {{!--ROW 2--}}
    <div class="two fields">
      <div class="field">
        <label>What's the distance from it's home Planet</label>
        <input type="text" name="distance">
      </div>
      <div class="field">
        <label>Whats it's diameter?</label>
        <input type="text" name="diameter">
      </div>
    </div>

    {{!--ROW 3--}}
    <div class="two fields">
      <div class="field">
        <label>Who discovered it?</label>
        <input type="text" name="discoveredBy">
      </div>
      <div class="field">
        <label>What year was it discovered?</label>
        <input type="text" name="yearDiscovered">
      </div>
    </div>

    {{!--ROW 4--}}
    <div class="two fields">
      <div class="field">
        <label>Put your moon image here</label>
        <input type="file" name="image" required>
      </div>
      <div class="field">
        <label>Who is the image courtesyof?</label>
        <input type="text" name="courtesy" required>
      </div>
    </div>

    {{!--FINAL FIELD--}}
    <div class="field">
      <label>Who's adding this moon?</label>
      <input type="text" name="credit">
    </div>

    {{!--Submit--}}
    <button class="ui primary button" type="submit">Add Moon</button>

  </form>

</div>