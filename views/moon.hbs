{{> menu}}

<div class="ui raised segment" style="margin-top: 1.5rem;">
  <div class="ui stackable two column grid">

    <div class="eight wide column">
      <h1 class="ui header">
        <i class="moon icon"></i>
        <div class="content">
          Steve’s App – Moon Tracker
          <div class="sub header">{{moon.name}} | Orbits {{moon.planet}}</div>
        </div>
      </h1>
    </div>

    <div class="eight wide column" style="display: flex; align-items: center; justify-content: center;">
      <div style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;">
        <a href="/planet/1"><img src="/images/planets/Mercury.gif" style="width:40px; height:40px; border-radius:50%;"></a>
        <a href="/planet/2"><img src="/images/planets/Venus.gif" style="width:40px; height:40px; border-radius:50%;"></a>
        <a href="/planet/3"><img src="/images/planets/Earth.gif" style="width:40px; height:40px; border-radius:50%;"></a>
        <a href="/planet/4"><img src="/images/planets/Mars.gif" style="width:40px; height:40px; border-radius:50%;"></a>
        <a href="/planet/5"><img src="/images/planets/Jupiter.gif" style="width:40px; height:40px; border-radius:50%;"></a>
        <a href="/planet/6"><img src="/images/planets/Saturn.gif" style="width:40px; height:40px; border-radius:50%;"></a>
        <a href="/planet/7"><img src="/images/planets/Uranus.gif" style="width:40px; height:40px; border-radius:50%;"></a>
        <a href="/planet/8"><img src="/images/planets/Neptune.gif" style="width:40px; height:40px; border-radius:50%;"></a>
      </div>
    </div>

  </div>
</div>

<div class="ui container">
  <div class="ui stackable grid">

    <div class="eight wide column">
      <div class="ui raised segment" style="padding: 1px;">
        <img class="ui fluid rounded image" src="{{moon.image}}" style="height: 400px; object-fit: cover;">
      </div>
    </div>

    <div class="eight wide column">
      <div class="ui raised segment">

        <h3 class="ui header">{{moon.name}}</h3>
        <p><strong>Orbits:</strong> {{moon.planet}}</p>

        {{#if moon.description}}
          <p><strong>Description:</strong><br>{{moon.description}}</p>
        {{/if}}

        {{#if moon.distance}}
          <p><strong>Distance from Planet:</strong> {{moon.distance}}</p>
        {{/if}}

        {{#if moon.diameter}}
          <p><strong>Diameter:</strong> {{moon.diameter}}</p>
        {{/if}}

        {{#if moon.discoveredBy}}
          <p><strong>Discovered By:</strong> {{moon.discoveredBy}}</p>
        {{/if}}

        {{#if moon.yearDiscovered}}
          <p><strong>Year Discovered:</strong> {{moon.yearDiscovered}}</p>
        {{/if}}

        {{#if moon.courtesy}}
          <p><strong>Image Courtesy Of:</strong> {{moon.courtesy}}</p>
        {{/if}}

        {{#if moon.credit}}
          <p><strong>Uploaded By:</strong> {{moon.credit}}</p>
        {{/if}}

        <div class="ui divider"></div>

        <a href="{{planetLink}}" class="ui primary button">
          Go to {{moon.planet}}
        </a>

      </div>
    </div>

  </div>
</div>